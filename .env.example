# ---- Core ----
# manage.py uses config.settings.dev; gunicorn/Docker use config.settings.prod (override with the DJANGO_SETTINGS_MODULE env var)
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SITE_URL=http://localhost:8000

# ---- MySQL ----
DB_NAME=parkshare
DB_USER=parkshare
DB_PASSWORD=parkshare
DB_HOST=127.0.0.1
DB_PORT=3306

# ---- Superadmin (created/updated automatically on every migrate) ----
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=admin1234

# ---- Razorpay (use TEST keys in development: https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks: URL https://YOUR-DOMAIN/payments/webhook/ ; events: payment.captured, payment.failed,
# order.paid, refund.processed, refund.failed
RAZORPAY_WEBHOOK_SECRET=
AUTO_COMPLETE_HOURS=6

# ---- Cloudinary (required in production) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Email (console backend is used when EMAIL_HOST is empty) ----
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Parking360 <no-reply@example.com>

# ---- Optional: shared cache for rate limiting (recommended in production) ----
REDIS_URL=

# ---- Security and operations ----
# Hide the Django admin behind an unguessable path, e.g. ADMIN_URL=staff-k39x/
ADMIN_URL=django-admin/
# off | report-only | enforce. Start with report-only, test checkout / QR scan / dashboards, then switch to enforce.
CSP_MODE=report-only
CSP_REPORT_URI=
# Optional error tracking (also `pip install sentry-sdk`)
SENTRY_DSN=
ENVIRONMENT=production
# Set RUN_MIGRATIONS=0 on extra web replicas so only one container migrates.
RUN_MIGRATIONS=1

# ---- Free-hosting extras ----
# Database engine. Leave unset for MySQL. Use django_tidb for TiDB Cloud (free).
# DB_ENGINE=django_tidb
# Encrypt the database connection (managed services). REQUIRED works without any certificate file.
DB_SSL_MODE=
# Optional: path to the database provider CA certificate to also verify the server (e.g. /app/certs/ca.pem)
DB_SSL_CA=
# Long random secret that lets a free cron service call https://YOUR-SITE/jobs/run/?token=THE_SECRET
JOBS_TOKEN=

# ---- Production only ----
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
