# Copy to ../../.env on the server and fill in. Never commit .env.
DOMAIN=parkshare.duckdns.org
SECRET_KEY=change-me-replace-with-output-of-the-python-command-in-the-guide
DEBUG=False
ADMIN_URL=staff-change-me/
CSP_MODE=report-only

DB_NAME=parkshare
DB_USER=parkshare
DB_PASSWORD=change-me-db-password
DB_ROOT_PASSWORD=change-me-root-password

SUPERADMIN_EMAIL=you@example.com
SUPERADMIN_PASSWORD=Change-Me-To-A-Strong-Password-1

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Brevo free SMTP (or any SMTP). Leave EMAIL_HOST empty to print emails to the logs instead.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=ParkShare <no-reply@yourdomain.com>

SECURE_SSL_REDIRECT=True
