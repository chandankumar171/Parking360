ngRight=6;" vertex="1" parent="1"><mxGeometry x="960" y="480" width="270" height="118" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p9" name="9. Dashboards and next phase"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p9-title" value="Dashboards, operations and delivery" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="900" height="36" as="geometry"/></mxCell><mxCell id="p9-u1" value="Owner / superadmin&lt;br&gt;opens the dashboard" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="156" height="54" as="geometry"/></mxCell><mxCell id="p9-f1" value="Filter bar: Year, Month, Week, Custom;&lt;br&gt;group by day / week / month;&lt;br&gt;parking (owner)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="92" width="200" height="86" as="geometry"/></mxCell><mxCell id="p9-a1" value="fetch /dashboard/api/overview/&lt;br&gt;(role-checked, owner data&lt;br&gt;only)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="92" width="190" height="86" as="geometry"/></mxCell><mxCell id="p9-a2" value="Metrics engine: buckets by&lt;br&gt;local date in Python, so no&lt;br&gt;MySQL timezone tables needed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="740" y="92" width="210" height="86" as="geometry"/></mxCell><mxCell id="p9-db" value="M