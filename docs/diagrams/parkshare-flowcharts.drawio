r&gt;cannot be deleted: close it&lt;br&gt;for new bookings instead." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#fffbe6;strokeColor=#bf9000;fontSize=10;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="740" y="585" width="190" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="4. Search, booking and payment"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p4-lane1" value="Driver" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=36;fillColor=#f8f9fa;strokeColor=#c0c0c0;fontStyle=1;fontSize=13;swimlaneFillColor=#fcfcfc;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="2340" height="230" as="geometry"/></mxCell><mxCell id="p4-lane2" value="System" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=36;fillColor=#f8f9fa;strokeColor=#c0c0c0;fontStyle=1;fontSize=13;swimlaneFillColor=#fcfcfc;" vertex="1" parent="1"><mxGeometry x="20" y="290" width="2340" height="230" as="geometry"/></mxCell><mxCell id="p4-lane3" value="Razorpay and rules" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=36;fillColor=#f8f9fa;strokeColor=#c0c0c0;fontStyle=1;fontSize=13;swimlaneFillColor=#fcfcfc;" vertex="1" parent="1"><mxGeometry x="20" y="520" width="2340" height="230" as="geometry"/></mxCell><mxCell id="p4-title" value="Driver: search, book a bay and pay" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="900" height="36" as="geometry"/></mxCell><mxCell id="p4-d1" value="Driver opens&lt;br&gt;Find parking" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="82" y="148" width="156" height="54" as="geometry"/></mxCell><mxCell id="p4-d2" value="Search: text, vehicle, price,&lt;br&gt;amenities, near me,&lt;br&gt;available-at time" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="135" width="170" height="80" as="geometry"/></mxCell><mxCell id="p4-d3" value="Parking page: photos, prices,&lt;br&gt;overtime rules,&lt;br&gt;live availability" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="525" y="135" width="170" height="80" as="geometry"/></mxCell><mxCell id="p4-d4" value="Pick vehicle type,&lt;br&gt;date, start time,&lt;br&gt;number of slots" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="750" y="140" width="170" height="70" as="geometry"/></mxCell><mxCell id="p4-d5" value="Enter plate + brand/model&lt;br&gt;(or saved vehicle),&lt;br&gt;accept terms" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="975" y="140" width="170" height="70" as="geometry"/></mxCell><mxCell id="p4-f1" value="Sees why (closed, full&lt;br&gt;or invalid) and adjusts" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="145" width="170" height="60" as="geometry"/></mxCell><mxCell id="p4-d6" value="Booking page:&lt;br&gt;pay within 10 minutes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1425" y="140" width="170" height="70" as="geometry"/></mxCell><mxCell id="p4-d7" value="Driver sees booking&lt;br&gt;code + QR" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;s