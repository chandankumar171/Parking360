nded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;" edge="1" parent="1" source="p4-d4" target="p4-d5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e8" value="live quote" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="p4-d4" target="p4-s1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e9" value="submit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;" edge="1" parent="1" source="p4-d5" target="p4-s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e10" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;" edge="1" parent="1" source="p4-s2" target="p4-s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e11" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;" edge="1" parent="1" source="p4-s2" target="p4-f1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e12" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;" edge="1" parent="1" source="p4-s3" target="p4-s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e13" value="No: full" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;" edge="1" parent="1" source="p4-s3" target="p4-f1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e14" value="adjust" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4-f1" target="p4-d4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e15" value="redirect" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;" edge="1" parent="1" source="p4-s4" target="p4-d6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e16" value="Pay" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;" edge="1" parent="1" source="p4-d6" target="p4-s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e17" value="order id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;" edge="1" parent="1" source="p4-s5" target="p4-r1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e18" value="browser callback + signature" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.25;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4-r1" target="p4-s6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e19" value="webhook" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4-r2" target="p4-s6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e20" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;" edge="1" parent="1" source="p4-s6" target="p4-s7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e21" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;exitX=0.75;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4-s6" target="p4-x1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e22" value="show code" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;" edge="1" parent="1" source="p4-s7" target="p4-d7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-n0" value="Window valid: shop open, up to 60 days ahead,&lt;br&gt;whole stay inside opening hours, not in the past.&lt;br&gt;Free bay: peak overlap stays below capacity&lt;br&gt;(vehicle-type row locked while booking)." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#fffbe6;strokeColor=#bf9000;fontSize=10;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="68" y="570" width="215" height="130" as="geometry"/></mxCell><mxCell id="p4-n1" value="Hold lapses after 10 min (or the driver&lt;br&gt;releases it): EXPIRED, bay freed.&lt;br&gt;Cron: expire_pending_bookings." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#fffbe6;strokeColor=#bf9000;fontSize=10;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="518" y="580" width="215" height="110" as="geometry"/></mxCell><mxCell id="p4-n2" value="Paid after the hold expired: confirmed if the&lt;br&gt;bay is still free, otherwise an automatic&lt;br&gt;full refund." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#fffbe6;strokeColor=#bf9000;fontSize=10;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="968" y="580" width="215" height="110" as="geometry"/></mxCell><mxCell id="p4-n3" value="Payment verified = Razorpay signature valid and&lt;br&gt;amount equals the server-side price. The browser&lt;br&gt;callback and the webhook are both idempotent.&lt;br&gt;Max 3 unpaid holds per driver; one plate cannot&lt;br&gt;have overlapping bookings." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#fffbe6;strokeColor=#bf9000;fontSize=10;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1418" y="565" width="215" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="5. Gate flow and overtime"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p5-lane1" value="Driver" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=36;fillColor=#f8f9fa;strokeColor=#c0c0c0;fontStyle=1;fontSize=13;swimlaneFillColor=#fcfcfc;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="2340" height="230" as="geometry"/></mxCell><mxCell id="p5-lane2" value="Owner" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=36;fillColor=#f8f9fa;strokeColor=#c0c0c0;fontStyle=1;fontSize=13;swimlaneFillColor=#fcfcfc;" vertex="1" parent="1"><mxGeometry x="20" y="290" width="2340" height="230" as="geometry"/></mxCell><mxCell id="p5-lane3" value="System" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=36;fillColor=#f8f9fa;strokeColor=#c0c0c0;fontStyle=1;fontSize=13;swimlaneFillColor=#fcfcfc;" vertex="1" parent="1"><mxGeometry x="20" y="520" width="2340" height="230" as="geometry"/></mxCell><mxCell id="p5-title" value="At the gate: check-in, checkout, overtime and completion" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="900" height="36" as="geometry"/></mxCell><mxCell id="p5-g1" value="Driver arrives and&lt;br&gt;shows code / QR" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="82" y="148" width="156" height="54" as="geometry"/></mxCell><mxCell id="p5-n1" value="Cron mark_no_shows (5 min): CONFIRMED and&lt;br&gt;not checked in by start + grace becomes&lt;br&gt;NO_SHOW (no refund, points penalty)." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#fffbe6;strokeColor=#bf9000;fontSize=10;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="505" y="125" width="210" height="100" as="geometry"/></mxCell><mxCell id="p5-n2" value="Cron auto_complete_bookings: a stay never&lt;br&gt;checked out after 6 h is closed as COMPLETED&lt;br&gt;with a points penalty." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#fffbe6;strokeColor=#bf9000;fontSize=10;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="730" y="125" width="210" height="100" as="geometry"/></mxCell><mxCell id="p5-d2" value="Driver leaves and&lt;br&gt;shows the code again" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="140" width="170" height="70" as="geometry"/></mxCell><mxCell id="p5-d3" value="Driver pays overtime in&lt;br&gt;Razorpay (booking page),&lt;br&gt;credited to the owner" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1650" y="140" width="170" height="70" as="geometry"/></mxCell><mxCell id="p5-d4" value="Driver rates the stay (1-5 stars,&lt;br&gt;edit for 7 days). Owner may&lt;br&gt;reply once." style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2092" y="125" width="186" height="100" as="geometry"/></mxCell><mxCell id="p5-o1" value="Owner enters or&lt;br&gt;scans the 6-char code" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="370" width="170" height="70" as="geometry"/></mxCell><mxCell id="p5-e1" value="Error: wrong parking,&lt;br&gt;cancelled or expired code" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="525" y="375" width="170" height="60" as="geometry"/></mxCell><mxCell id="p5-e2" value="Too early (opens 15 min&lt;br&gt;before start) or grace&lt;br&gt;over: no-show" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="750" y="370" width="170" height="70" as="geometry"/></mxCell><mxCell id="p5-o2" value="Owner confirms&lt;br&gt;&amp;#x27;vehicle parked&amp;#x27;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="975" y="370" width="170" height="70" as="geometry"/></mxCell><mxCell id="p5-o3" value="Owner enters code:&lt;br&gt;Start checkout" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1425" y="370" width="170" height="70" as="geometry"/></mxCell><mxCell id="p5-o4" value="Verdict on the driver:&lt;br&gt;satisfied or not&lt;br&gt;(comment if not)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1875" y="370" width="170" height="70" as="geometry"/></mxCell><mxCell id="p5-s1" value="Code and&lt;br&gt;booking OK?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="510" y="575" width="200" height="120" as="geometry"/></mxCell><mxCell id="p5-s2" value="In check-in&lt;br&gt;window?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="735" y="575" width="200" height="120" as="geometry"/></mxCell><mxCell id="p5-s3" value="Status CHECKED_IN,&lt;br&gt;time saved,&lt;br&gt;driver notified" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="975" y="600" width="170" height="70" as="geometry"/></mxCell><mxCell id="p5-s4" value="Freeze overtime =&lt;br&gt;ceil((late - free) / block)&lt;br&gt; x charge" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1425" y="595" width="170" height="80" as="geometry"/></mxCell><mxCell id="p5-s5" value="Overtime&lt;br&gt;&amp;gt; 0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1635" y="575" width="200" height="120" as="geometry"/></mxCell><mxCell id="p5-s6" value="COMPLETED, driver points&lt;br&gt;up or down, checkout&lt;br&gt;time saved" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2100" y="597" width="170" height="76" as="geometry"/></mxCell><mxCell id="p5-e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;" edge="1" parent="1" source="p5-g1" target="p5-o1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;" edge="1" parent="1" source="p5-o1" target="p5-s1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e6" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;" edge="1" parent="1" source="p5-s1" target="p5-e1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e7" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;" edge="1" parent="1" source="p5-s1" target="p5-s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e8" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;" edge="1" parent="1" source="p5-s2" target="p5-e2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e9" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;" edge="1" parent="1" source="p5-s2" target="p5-o2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;" edge="1" parent="1" source="p5-o2" target="p5-s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e11" value="later, at exit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;" edge="1" parent="1" source="p5-s3" target="p5-d2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;" edge="1" parent="1" source="p5-d2" target="p5-o3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;" edge="1" parent="1" source="p5-o3" target="p5-s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;" edge="1" parent="1" source="p5-s4" target="p5-s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e15" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;" edge="1" parent="1" source="p5-s5" target="p5-d3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e16" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;" edge="1" parent="1" source="p5-s5" target="p5-o4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e17" value="paid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;" edge="1" parent="1" source="p5-d3" target="p5-o4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;" edge="1" parent="1" source="p5-o4" target="p5-s6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;" edge="1" parent="1" source="p5-s6" target="p5-d4"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p6" name="6. Cancellation and refunds"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p6-lane1" value="Driver" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=36;fillColor=#f8f9fa;strokeColor=#c0c0c0;fontStyle=1;fontSize=13;swimlaneFillColor=#fcfcfc;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="2340" height="230" as="geometry"/></mxCell><mxCell id="p6-lane2" value="Owner" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=36;fillColor=#f8f9fa;strokeColor=#c0c0c0;fontStyle=1;fontSize=13;swimlaneFillColor=#fcfcfc;" vertex="1" parent="1"><mxGeometry x="20" y="290" width="2340" height="230" as="geometry"/></mxCell><mxCell id="p6-lane3" value="System and Razorpay" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=36;fillColor=#f8f9fa;strokeColor=#c0c0c0;fontStyle=1;fontSize=13;swimlaneFillColor=#fcfcfc;" vertex="1" parent="1"><mxGeometry x="20" y="520" width="2340" height="230" as="geometry"/></mxCell><mxCell id="p6-title" value="Cancellation and refunds (Razorpay Refund API)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="900" height="36" as="geometry"/></mxCell><mxCell id="p6-r0" value="Booking is&lt;br&gt;CONFIRMED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="82" y="148" width="156" height="54" as="geometry"/></mxCell><mxCell id="p6-r1" value="Driver: Cancel and&lt;br&gt;request refund&lt;br&gt;(with a reason)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="140" width="170" height="70" as="geometry"/></mxCell><mxCell id="p6-d2" value="Not allowed: parking is&lt;br&gt;non-refundable, window&lt;br&gt;closed, or not CONFIRMED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="522" y="140" width="176" height="70" as="geometry"/></mxCell><mxCell id="p6-d3" value="Declined with a reason:&lt;br&gt;booking back to CONFIRMED,&lt;br&gt;driver notified" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="975" y="135" width="170" height="80" as="geometry"/></mxCell><mxCell id="p6-d4" value="Refund reaches the original&lt;br&gt;payment method in&lt;br&gt;5-7 working days" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2092" y="135" width="186" height="80" as="geometry"/></mxCell><mxCell id="p6-oc1" value="Owner-initiated: cancel&lt;br&gt;any CONFIRMED booking&lt;br&gt;(with a reason)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="75" y="370" width="170" height="70" as="geometry"/></mxCell><mxCell id="p6-o1" value="Owner&lt;br&gt;approves?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="345" width="200" height="120" as="geometry"/></mxCell><mxCell id="p6-o3" value="Refund FAILED: owner&lt;br&gt;sees the error and&lt;br&gt;presses Retry" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1430" y="370" width="160" height="70" as="geometry"/></mxCell><mxCell id="p6-m1" value="Overtime payments are not&lt;br&gt;refunded automatically." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#fffbe6;strokeColor=#bf9000;fontSize=10;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1640" y="370" width="190" height="70" as="geometry"/></mxCell><mxCell id="p6-m2" value="Auto-refund: payment arrived after&lt;br&gt;the hold lapsed and the bay&lt;br&gt;was already taken." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#fffbe6;strokeColor=#bf9000;fontSize=10;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1860" y="360" width="200" height="90" as="geometry"/></mxCell><mxCell id="p6-s1" value="Cancel&lt;br&gt;allowed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="510" y="575" width="200" height="120" as="geometry"/></mxCell><mxCell id="p6-s2" value="Refund REQUESTED;&lt;br&gt;booking REFUND_REQUESTED&lt;br&gt;(bay still held);&lt;br&gt;owner notified" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="750" y="594" width="170" height="82" as="geometry"/></mxCell><mxCell id="p6-s4" value="APPROVED then PROCESSING:&lt;br&gt;call Razorpay Refund API&lt;br&gt;(paid - cancellation charge)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="595" width="170" height="80" as="geometry"/></mxCell><mxCell id="p6-s5" value="Razorpay&lt;br&gt;accepted?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1410" y="575" width="200" height="120" as="geometry"/></mxCell><mxCell id="p6-s6" value="Webhook refund.processed&lt;br&gt;(signed, idempotent)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1650" y="600" width="170" height="70" as="geometry"/></mxCell><mxCell id="p6-s7" value="REFUNDED: booking CANCELLED,&lt;br&gt;bay freed, ledger refund +&lt;br&gt;fee reversal, both notified" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1865" y="595" width="190" height="80" as="geometry"/></mxCell><mxCell id="p6-e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;" edge="1" parent="1" source="p6-r0" target="p6-r1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6-e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;f