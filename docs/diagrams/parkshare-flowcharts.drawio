eStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;" edge="1" parent="1" source="p9-a1" target="p9-a2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p9-e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=block;startFill=1;" edge="1" parent="1" source="p9-a2" target="p9-db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p9-e5" value="JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p9-a2" target="p9-c1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p9-e6" value="same filters" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="p9-f1" target="p9-x1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p9-e7" value="owner only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="p9-u1" target="p9-l1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p9-ph7" value="Phase 7 (built): production hardening and delivery&lt;br&gt;Security headers (CSP, Permissions-Policy), rate limits on money endpoints, hidden admin URL  |  database indexes, N+1 query guards, landing-page cache&lt;br&gt;Built-in scheduler, payment reconciliation check, seed_demo_data  |  Docker + CI pipeline  |  architecture and deployment guides" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#fffbe6;strokeColor=#bf9000;fontSize=10;align=left;spacingLeft=6;spacingRight=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="1160" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
