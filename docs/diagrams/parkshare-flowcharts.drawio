l><mxCell id="p7-m5" value="Ledger CREDIT:&lt;br&gt;owner share" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="980" y="90" width="170" height="60" as="geometry"/></mxCell><mxCell id="p7-m6" value="Ledger PLATFORM_FEE (memo):&lt;br&gt;platform earnings" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="980" y="250" width="190" height="60" as="geometry"/></mxCell><mxCell id="p7-o1" value="Driver pays overtime&lt;br&gt;at checkout" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="170" height="70" as="geometry"/></mxCell><mxCell id="p7-q0" value="Owner approves a refund&lt;br&gt;or cancels a booking" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="170" height="70" as="geometry"/></mxCell><mxCell id="p7-q1" value="Razorpay Refund API&lt;br&gt;returns the money&lt;br&gt;to the driver" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="510" y="420" width="190" height="80" as="geometry"/></mxCell><mxCell id="p7-q2" value="Ledger REFUND_DEBIT (owner)&lt;br&gt;+ FEE_REVERSAL (platform)&lt;br&gt;in the same proportion" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="980" y="420" width="200" height="70" as="geometry"/></mxCell><mxCell id="p7-p1" value="Superadmin pays the owner&lt;br&gt;by UPI / bank, outside&lt;br&gt;the app" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="170" height="70" as="geometry"/></mxCell><mxCell id="p7-p2" value="Record payout + reference&lt;br&gt;(cannot exceed the&lt;br&gt;balance owed)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="510" y="590" width="170" height="70" as="geometry"/></mxCell><mxCell id="p7-p3" value="Ledger PAYOUT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="980" y="590" width="170" height="60" as="geometry"/></mxCell><mxCell id="p7-b1" value="Owner balance owed =&lt;br&gt;CREDIT - REFUND_DEBIT&lt;br&gt;- PAYOUT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1215" y="250" width="200" height="84" as="geometry"/></mxCell><mxCell id="p7-v1" value="Owner: Earnings page and&lt;br&gt;dashboard &amp;#x27;Owed to you&amp;#x27;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1480" y="100" width="170" height="70" as="geometry"/></mxCell><mxCell id="p7-v2" value="Superadmin: Payments,&lt;br&gt;Payouts, platform earnings" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1480" y="430" width="170" height="70" as="geometry"/></mxCell><mxCell id="p7-n1" value="A refund returns only that payment&amp;#x27;s&lt;br&gt;share. A cancellation charge that is kept&lt;br&gt;stays split between owner and platform&lt;br&gt;in the original proportion." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#fffbe6;strokeColor=#bf9000;fontSize=10;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1225" y="570" width="220" height="100" as="geometry"/></mxCell><mxCell id="p7-e1