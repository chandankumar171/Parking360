Size=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="700" y="290" width="190" height="60" as="geometry"/></mxCell><mxCell id="p8-NOSHOW" value="NO_SHOW" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="700" y="520" width="170" height="60" as="geometry"/></mxCell><mxCell id="p8-CANCELLED" value="CANCELLED&lt;br&gt;(refunded)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="700" y="100" width="170" height="60" as="geometry"/></mxCell><mxCell id="p8-COMPLETED" value="COMPLETED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1020" y="290" width="170" height="60" as="geometry"/></mxCell><mxCell id="p8-e1" value="bay held" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;" edge="1" parent="1" source="p8-s0" target="p8-PENDING"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8-e2" value="payment verified&lt;br&gt;(signature / webhook)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#555555;" edge="1" parent="1" source="p8-PENDING" target="p8-CONFIRMED"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8-e3" value="hold lapses or&lt;br&gt;driver releases" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;end